{
  "name": "planora-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client && npm run build:server",
    "start": "npm --prefix server run start",
    "start:server": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "db:reset": "npm --prefix server run db:reset",
    "db:inspect": "npm --prefix server run db:inspect",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
